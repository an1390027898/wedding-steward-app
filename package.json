{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:github": "vite build --config vite.github.config.ts",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:dist:win": "npm run desktop:build && electron-builder --win nsis --publish never",
    "desktop:dist:mac": "npm run desktop:build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "cn.wedding.steward",
    "productName": "婚礼管家",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "desktop-dist/**/*",
      "public/app-icon-512.png",
      "public/app-icon-1024.png",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "icon": "public/app-icon-1024.png",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "public/app-icon-512.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "婚礼管家"
    }
  }
}
